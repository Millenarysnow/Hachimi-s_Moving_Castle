#ifndef AERIAL_CLOUD_DENSITY_INCLUDED
#define AERIAL_CLOUD_DENSITY_INCLUDED

// 在物理世界坐标上推进采样。相位增大时，相同密度就会向航行的反方向经过镜头。
float2 AerialCloudUV(float3 PositionCm, float3 Phase, float PeriodKm)
{
    return PositionCm.xy / (100000.0 * PeriodKm) + Phase.xy;
}

float AerialCloudFarWeight(float DistanceCm, float StartKm, float EndKm)
{
    return 1.0 - smoothstep(StartKm, EndKm, DistanceCm * 0.00001);
}

// 保守密度只跳过详细模型也严格为零的区域；不拿二维图近似云的最终轮廓。
float4 AerialCloudSupport(Texture2D Weather, SamplerState WeatherSampler, float2 UV, float Height,
    float DistanceCm, float StartKm, float EndKm)
{
    const float2 WeatherData = Weather.SampleLevel(WeatherSampler, UV, 0).rg;
    const float FarWeight = AerialCloudFarWeight(DistanceCm, StartKm, EndKm);
    // 大尺度覆盖只调制厚云。即使覆盖接近零，云层内部也保留稀薄散射，不能把它当空区跳过。
    const float HasMass = (Height > 0.025 && Height < 0.98 && FarWeight > 0.0) ? 1.0 : 0.0;
    return float4(HasMass, WeatherData, FarWeight);
}

float2 AerialCloudMedium(Texture3D Shape, SamplerState ShapeSampler, float2 UV, float Height, float HeightCm,
    float PeriodKm, float4 Support, float Extinction)
{
    const float Coverage = Support.y;
    const float HeightPattern = Support.z;
    const float FarWeight = Support.w;

    // 跨过完整云周期时，各轴的采样相位回到完全相同的体积数据。Z 的物理尺度跟 XY 一致，
    // 不让一整个噪声立方体被硬压到很薄的云层里。不同剖面来自云团本身，而非相机方向。
    const float3 ShapeUV = 6.0 * float3(UV, HeightCm / (PeriodKm * 100000.0)) + float3(0.237, 0.583, 0.317);
    const float2 Macro = Shape.SampleLevel(ShapeSampler, ShapeUV, 0).rg;
    const float2 Shoulder = Shape.SampleLevel(ShapeSampler, ShapeUV * 2.0 + float3(0.31, 0.17, 0.59), 0).gb;
    const float CloudBody = 0.73 * Macro.r + 0.14 * Macro.g + 0.13 * Shoulder.x;

    const float LocalTop = 0.27 + 0.17 * Coverage + 0.16 * HeightPattern + 0.39 * CloudBody + 0.10 * Shoulder.x;
    const float DepthUnderLobe = LocalTop - Height;
    const float LowerSoftness = smoothstep(0.025, 0.205 + 0.08 * HeightPattern, Height);
    const float UpperSoftness = smoothstep(0.0, 0.12, DepthUnderLobe) * (1.0 - smoothstep(0.86, 0.98, Height));

    // 主密度隆起、包住团块；更细的蚀刻只在团块肩部最明显，避免在实心亮面上铺一层噪点。
    const float BodyField = CloudBody + 0.32 * Coverage - 0.45;
    const float Edge = 1.0 - smoothstep(0.10, 0.41, BodyField);
    const float Detail = Shape.SampleLevel(ShapeSampler, ShapeUV * 3.0 + float3(0.23, 0.39, 0.11), 0).b;
    const float Body = smoothstep(-0.04, 0.23, BodyField - Edge * (1.0 - Detail) * 0.046);
    // 提高厚云聚集的覆盖阈值，给垂直穿过云层的视线留出间隙。云肩与碎絮仍跨过过渡带。
    const float Bank = smoothstep(0.56, 0.85, Coverage + 0.34 * (CloudBody - 0.48) + 0.045 * (Detail - 0.5));
    const float Lobe = Bank * LowerSoftness * UpperSoftness * Body;

    // 薄云使用同一份滚动的三维场，但不被厚云顶部截断。垂直穿过时透出地貌，斜穿时由原生追踪
    // 沿更长的路径自然累积消光；不根据俯仰角或屏幕中心划一个透明区域。
    const float VeilHeight = smoothstep(0.06, 0.25, Height) * (1.0 - smoothstep(0.57, 0.94, Height));
    const float VeilPattern = smoothstep(0.20, 0.81, 0.32 * Coverage + 0.50 * CloudBody + 0.18 * Detail);
    const float Veil = 0.00028 * VeilHeight * lerp(0.20, 1.0, VeilPattern);
    // 云隙中也有轮廓可辨的碎云：让三维云肩聚集成雾丝，再用不同的垂直剖面错开厚云顶部。
    const float WispHeight = smoothstep(0.22, 0.39, Height) * (1.0 - smoothstep(0.51 + 0.12 * HeightPattern, 0.78 + 0.12 * HeightPattern, Height));
    const float WispPattern = smoothstep(0.45, 0.78, 0.61 * CloudBody + 0.30 * Shoulder.x + 0.09 * Detail);
    const float Wisps = 0.006 * WispHeight * WispPattern * (1.0 - 0.55 * Bank);
    const float Density = Extinction * FarWeight * (Lobe + Veil + Wisps);

    // 天光遮蔽只随上覆厚云和云肩增强；稀薄云不压成灰黑面，厚云仍由同一消光场产生自阴影。
    const float Overburden = smoothstep(0.025, 0.36, DepthUnderLobe) * Bank;
    const float Valley = (1.0 - smoothstep(0.28, 0.70, CloudBody)) * Bank;
    const float SkyVisibility = exp2(-1.05 * Overburden - 0.74 * Valley * (0.45 + 0.55 * Shoulder.y));
    return float2(Density, lerp(1.0, SkyVisibility, FarWeight));
}

// 高度与云内遮蔽共同决定软色阶，保留连续过渡供原生体积积分做时间抗锯齿。
float AerialCloudLitBand(float Visibility, float Height, float Lower, float Upper)
{
    // 云腹的高度权重更大，减少下部无遮挡碎絮误入暖白亮阶，同时保留连续过渡。
    const float Exposure = 0.62 * Visibility + 0.38 * smoothstep(0.24, 0.76, Height);
    return smoothstep(Lower, Upper, Exposure);
}

#endif
